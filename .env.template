# region model_provider
SILICONFLOW_API_KEY=  # 推荐使用硅基流动免费服务 https://cloud.siliconflow.cn/i/Eo5yTHGJ
TAVILY_API_KEY=  # 获取搜索服务的 api key 请访问 https://app.tavily.com/

# 普通用户每日对话配额（按 Asia/Shanghai 自然日）。<=0 表示该闸不限；管理员不受限。
USER_DAILY_MESSAGE_LIMIT=60
USER_DAILY_TOKEN_LIMIT=500000

# 试用账号每晚清空（worker cron，时刻按 Asia/Shanghai）。逗号分隔用户名，只清 role=user。
TRIAL_CLEANUP_USERNAMES=trial
TRIAL_CLEANUP_HOUR=4
TRIAL_CLEANUP_MINUTE=30

# JWT 安全配置：首次部署请生成随机值，初始化脚本会在留空时自动生成
YUXI_ENV=development
JWT_SECRET_KEY=
YUXI_INSTANCE_ID=

# CORS allowed origins for browser clients, comma-separated.
# Development defaults to http://localhost:5173,http://127.0.0.1:5173 when unset.
# Production does not allow cross-origin browser requests unless this is explicitly set.
YUXI_CORS_ORIGINS=

# 前端允许的访问 Host（逗号分隔）。经反向代理或隧道域名访问时必须填，
# 否则 Vite dev server 会以 "Blocked request" 拒绝该 Host。留空等价于只允许 localhost。
# VITE_ALLOWED_HOSTS=localhost,your.domain.com

# 品牌配置：把 info.template.yaml 复制为 info.local.yaml 后指向它（info.local.yaml 已 gitignore）
# YUXI_BRAND_FILE_PATH=backend/package/yuxi/config/static/info.local.yaml

# # 其余可选配置
